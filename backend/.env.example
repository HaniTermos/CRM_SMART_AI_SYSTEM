# ============ SERVER ============
PORT=5002
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ============ DATABASE ============
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartstore_ai
DB_USER=postgres
DB_PASSWORD=

# ============ AUTH ============
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change-this-to-a-strong-random-secret

# ============ AI (Gemini) ============
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ============ EMAIL (SMTP) ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ============ FILE UPLOADS ============
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
